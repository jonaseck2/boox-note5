# boox: adb on any fresh system without on-screen authorization (Magisk overlay.d).
# Order-independent: the Mac's adb key is written by init, ro.adb.secure=0, and adbd restarts after both.
on post-fs-data
    mkdir /data/misc/adb 02750 system shell
    write /data/misc/adb/adb_keys "<~/.android/adbkey.pub>\n"
    chown system shell /data/misc/adb/adb_keys
    chmod 0640 /data/misc/adb/adb_keys
    restorecon /data/misc/adb/adb_keys
    exec u:r:magisk:s0 root root -- ${MAGISKTMP}/magisk resetprop -n ro.adb.secure 0
    setprop persist.sys.usb.config mtp,adb
    restart adbd

on boot
    setprop sys.usb.config mtp,adb

on property:sys.boot_completed=1
    exec u:r:magisk:s0 root root -- ${MAGISKTMP}/magisk --sqlite "REPLACE INTO settings (key,value) VALUES('root_access',3)"
    exec u:r:magisk:s0 root root -- ${MAGISKTMP}/magisk --sqlite "REPLACE INTO policies (uid,policy,until,logging,notification) VALUES(2000,2,0,1,0)"

# boox: run Onyx's composer with the EPDC shim (device/epdcshim). The shim makes the composer run its
# own e-ink update path (setEpdcList) for every frame, which a GSI's SurfaceFlinger never triggers.
service boox_composer /vendor/bin/hw/vendor.qti.hardware.display.composer-service
    class hal animation
    user system
    group graphics drmrpc
    # no 'capabilities': a capability-raised exec is AT_SECURE and the linker then ignores LD_PRELOAD
    onrestart restart surfaceflinger
    socket pps stream 0660 system system
    writepid /dev/cpuset/system-background/tasks
    setenv LD_PRELOAD /vendor/lib64/libbooxepdc.so
    disabled

on property:init.svc.vendor.qti.hardware.display.composer=running
    stop vendor.qti.hardware.display.composer
    start boox_composer
